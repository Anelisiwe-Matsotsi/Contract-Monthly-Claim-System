@model PROG6212_POE.Models.Claim

@{
    ViewData["Title"] = "Invoice";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h2 class="mb-0">INVOICE</h2>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <strong>Invoice Date:</strong> @DateTime.Now.ToString("yyyy-MM-dd")<br>
                    <strong>Claim Month:</strong> @Model.Month<br>
                    <strong>Invoice #:</strong> CLAIM-@Model.ClaimId
                </div>
                <div class="col-md-6 text-end">
                    <strong>Status:</strong> <span class="badge bg-success">@Model.ClaimStatus</span><br>
                    <strong>Submission Date:</strong> @Model.SubmissionDate.ToString("yyyy-MM-dd")
                </div>
            </div>

            <hr>

            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>Lecturer Information</h5>
                    <strong>Name:</strong> @Model.Lecturer?.FullName<br>
                    <strong>Department:</strong> @Model.Lecturer?.Department<br>
                    <strong>Email:</strong> @Model.Lecturer?.Email
                </div>
            </div>

            <hr>

            <div class="row mb-4">
                <div class="col-md-12">
                    <h5>Claim Details</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Description</th>
                                    <th>Hours</th>
                                    <th>Rate</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Teaching Services for @Model.Month</td>
                                    <td>@Model.TotalHoursWorked hours</td>
                                    <td>R@(Model.HourlyRate.ToString("F2"))/hour</td>
                                    <td>R@(Model.TotalAmount.ToString("F2"))</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total Amount:</strong></td>
                                    <td><strong>R@(Model.TotalAmount.ToString("F2"))</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="row mb-4">
                    <div class="col-md-12">
                        <h5>Notes</h5>
                        <p>@Model.Notes</p>
                    </div>
                </div>
            }
            <div class="row">
                <div class="col-md-12">
                    <form asp-action="DownloadInvoicePdf" method="post" class="d-inline">
                        <input type="hidden" name="claimId" value="@Model.ClaimId" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-file-pdf"></i> Download PDF Invoice
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <div class="mt-4">
        <a asp-action="GenerateReport" class="btn btn-secondary">Back to Reports</a>
    </div>
</div>