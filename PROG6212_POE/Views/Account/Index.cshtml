@{
    ViewData["Title"] = "User Login";
}
<!--Khadka , 2025-->
<body>
    <main role="main">
        <div class="login-wrap">
            <div class="login-html">

                <div class="login-form">
                    <!-- Sign In Form -->
                    <div class="sign-in-htm">
                        <h2 class="mb-4">Sign In</h2>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }

                        <form asp-action="Login" method="post">
                            <div class="group mb-3">
                                <label for="username" class="label">Username</label>
                                <input id="username" name="username" type="text" class="input form-control" placeholder="Enter your username" required>
                            </div>

                            <div class="group mb-3">
                                <label for="password" class="label">Password</label>
                                <input id="password" name="password" type="password" class="input form-control" placeholder="Enter your password" required>
                            </div>


                            <div class="group mb-3">
                                <button type="submit" class="button btn btn-dark w-100">Login</button>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </main>
</body>
