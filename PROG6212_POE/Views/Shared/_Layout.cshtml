<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROG6212_POE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PROG6212_POE.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="custom-nav"> <!--Pirrera, 2025-->
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                @if (Context.Session.GetString("AccountUsername") == null)
                {
                    <li><a asp-area="" asp-controller="Account" asp-action="Index">Login</a></li>
                }
                else
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            Welcome, @Context.Session.GetString("AccountUsername")
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        </ul>
                    </li>
                }
                @if (Context.Session.GetString("AccountRole") == "HR")
                {
                    <li><a asp-area="" asp-controller="HR" asp-action="Index">HR</a></li>
                }
                @if (Context.Session.GetString("AccountRole") == "Lecturer")
                {
                    <li><a asp-area="" asp-controller="Lecturer" asp-action="Index">Lecturer</a></li>
                }
                @if (Context.Session.GetString("AccountRole") == "Coordinator")
                {
                    <li><a asp-area="" asp-controller="Coordinator" asp-action="Index">Coordinator</a></li>
                }
                @if (Context.Session.GetString("AccountRole") == "Manager")
                {
                    <li><a asp-area="" asp-controller="Manager" asp-action="Index">Manager</a></li>
                }
                
            </ul>
        </nav>
    </header>

          <main role="main" class="pb-3">
             <div class="container flex-grow-1">
                 @RenderBody()
             </div>
          </main>
 

@*     <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - PROG6212_POE 
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
