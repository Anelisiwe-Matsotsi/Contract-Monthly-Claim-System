@{
    ViewData["Title"] = "Manage Claims"; 
}
<!--Troelson and Japiske, 2021-->
<h1 class="display-4 fw-bold">Coordinator Dashboard</h1>
<!--Code from Codepen by Hawes, 2025-->
<div id="mainContent" class="outerContainer">

    <div class="topShadow"></div>

    <div class="innerContainer">
        <div class="searchRow clearfix">
            <div class="dbTitle">

                <h1>Manage Claims</h1>
            </div>
            <div class="dbSearch">
                <i class="fa fa-search"></i>
                <input type="text" placeholder="Search claims...">
            </div>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr class="clearBg">
                    <th>Lecturer</th>
                    <th>Month</th>
                    <th>Total Hours</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Submission Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>@claim.Lecturer.Name</td>
                        <td>@claim.Month</td>
                        <td>@claim.TotalHoursWorked</td>
                        <td>R @claim.TotalAmount</td>
                        <td>@claim.ClaimStatus</td>
                        <td>@claim.SubmissionDate.ToShortDateString()</td>
                        <td>
                            <form asp-action="Approve" asp-route-id="@claim.ClaimId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@claim.ClaimId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>
</div>

