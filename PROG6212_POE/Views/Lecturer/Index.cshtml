@model List<PROG6212_POE.Models.Claim>
@{
    ViewData["Title"] = "Lecturer Claims";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-bold">Lecturer Dashboard</h1>
        <a class="btn btn-primary" asp-action="Create">Submit New Claim</a>
    </div>

    <h2>My Claims</h2>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Claim Month</th>
                <th>Hourly Rate</th>
                <th>Total Hours</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Submission Date</th>
                <th>Documents</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.Month</td>
                    <td>@claim.HourlyRate.ToString("C")</td>
                    <td>@claim.TotalHoursWorked</td>
                    <td>@claim.TotalAmount.ToString("C")</td>
                    <td>@claim.ClaimStatus</td>
                    <td>@claim.SubmissionDate.ToShortDateString()</td>

                    <td>
                        @if (!string.IsNullOrEmpty(claim.DocumentFileName))
                        {
                            <a asp-action="Download" asp-route-fileName="@claim.DocumentFileName">@claim.DocumentFileName</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>