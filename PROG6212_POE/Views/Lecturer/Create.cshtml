@model PROG6212_POE.Models.Claim
@{
    ViewData["Title"] = "Submit Claim";
}
@* /*Troelson and Japiske, 2021*/ *@

<main class="create-page">
    <div class="container mt-5 form-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a class="btn btn-outline-secondary rounded-pill px-4" href="/Lecturer">
                Back to Claims
            </a>
            <h2 class="fw-bold">Submit New Claim</h2>
        </div>

        @* Display TempData Message for file size or validation errors *@
        @if (TempData["Message"] != null)
        {
                <div class="alert alert-danger" role="alert">
                @TempData["Message"]
                </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Lecturer Dropdown -->
                    <div class="mb-3">
                        <label asp-for="LecturerId" class="form-label fw-semibold">Select Lecturer</label>
                        <select asp-for="LecturerId" class="form-control" required>
                            <option value="">-- Select Lecturer --</option>
                            @foreach (var lecturer in ViewBag.Lecturer)
                            {
                                    <option value="@lecturer.LecturerId">@lecturer.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LecturerId" class="text-danger"></span>
                    </div>

                    <!-- Claim Month -->
                    <div class="mb-3">
                        <label asp-for="Month" class="form-label fw-semibold">Claim Month</label>
                        <input asp-for="Month" type="month" class="form-control" required />
                        <span asp-validation-for="Month" class="text-danger"></span>
                    </div>

                    <!-- Hours Worked -->
                    <div class="mb-3">
                        <label asp-for="TotalHoursWorked" class="form-label fw-semibold">Total Hours Worked</label>
                        <input asp-for="TotalHoursWorked" type="number" class="form-control" required />
                        <span asp-validation-for="TotalHoursWorked" class="text-danger"></span>
                    </div>

                    <!-- Hourly Rate -->
                    <div class="mb-3">
                        <label asp-for="HourlyRate" class="form-label fw-semibold">Hourly Rate (R)</label>
                        <input asp-for="HourlyRate" type="number" class="form-control" step="0.01" required />
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Add any comments or details about this claim..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <!-- File Upload -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Attach Supporting Documents</label>
                        <input type="file" name="uploadFile" class="form-control" required accept=".doc,.docx,.xls,.xlsx,.pdf" /> @* /* Stackoverflow, 2019*/ *@
                    </div>

                    <!-- Submit -->
                    <div class="text-end">
                        <button type="submit" class="btn btn-dark rounded-pill px-4">Submit Claim</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}

@* /*Reference List:
Stackoverflow.2019.
 Troelsen,A. and Japikse, P. 2021.Pro C# 9 with .NET 5:Foundational Principles and Practices in Programming. 10th ed.Apress.
 */ *@