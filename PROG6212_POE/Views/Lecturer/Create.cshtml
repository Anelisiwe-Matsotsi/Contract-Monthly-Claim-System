@{
    ViewData["Title"] = "Submit Claim";
}


<main class="create-page">
    <div class="container mt-5 form-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">Submit New Claim</h2>
            <a class="btn btn-outline-secondary rounded-pill px-4" href="/Claims">
                Back to Claims
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="Month" class="form-label fw-semibold">Month</label>
                        <input type="month" id="Month" name="Month" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label for="TotalHours" class="form-label fw-semibold">Total Hours Worked</label>
                        <input type="number" id="TotalHours" name="TotalHours" class="form-control" min="1" required>
                    </div>

                    <div class="mb-3">
                        <label for="Amount" class="form-label fw-semibold">Amount (R)</label>
                        <input type="number" id="Amount" name="Amount" class="form-control" min="1" step="0.01" required>
                    </div>

                    <div class="mb-3">
                        <label for="Notes" class="form-label fw-semibold">Notes (Optional)</label>
                        <textarea id="Notes" name="Notes" class="form-control" rows="3" placeholder="Add any comments or details about this claim..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Attach Supporting Documents</label>
                        <input type="file" class="form-control" name="SupportingFiles" multiple>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-dark rounded-pill px-4">
                            Submit Claim
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>