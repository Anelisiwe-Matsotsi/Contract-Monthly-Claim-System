@model PROG6212_POE.Models.Claim
@{
    ViewData["Title"] = "Submit Claim";
    var hourlyRate = ViewBag.LecturerHourlyRate;
    var lecturerName = ViewBag.LecturerName;
}
@* /*Troelson and Japiske, 2021*/ *@

<main class="create-page">
    <div class="container mt-5 form-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a class="btn btn-outline-secondary rounded-pill px-4" href="/Lecturer">
                Back to Claims
            </a>
            <h2 class="fw-bold">Submit New Claim</h2>
        </div>

        @* Display TempData Message for file size or validation errors *@
        @if (TempData["Message"] != null)
        {
                <div class="alert alert-danger" role="alert">
                @TempData["Message"]
                </div>
        }
        @if (TempData["MessageSuccess"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["MessageSuccess"]
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Lecturer Information -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lecturer</label>
                        <input type="text" class="form-control" value="@lecturerName" readonly />
                        <small class="text-muted">Your name as registered by HR</small>
                    </div>

                    <!-- Hourly Rate Display -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hourly Rate</label>
                        <input type="text" class="form-control" value="R @hourlyRate" readonly />
                        <small class="text-muted">Your hourly rate as set by HR</small>
                    </div>

                    <!-- Claim Month -->
                    <div class="mb-3">
                        <label for="Month" class="form-label fw-semibold">Claim Month</label>
                        <input name="Month" type="month" class="form-control" required />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Hours Worked -->
                    <div class="mb-3">
                        <label for="TotalHoursWorked" class="form-label fw-semibold">Total Hours Worked</label>
                        <input name="TotalHoursWorked" type="number" class="form-control"
                               min="1" max="180" required />
                        <small class="text-muted">Maximum 180 hours per month</small>
                        <span class="text-danger"></span>
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label for="Notes" class="form-label fw-semibold">Notes</label>
                        <textarea name="Notes" class="form-control" rows="3"
                                  placeholder="Add any comments or details about this claim..."></textarea>
                    </div>

                    <!-- File Upload -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Attach Supporting Document</label>
                        <input type="file" name="uploadFile" class="form-control" required
                               accept=".pdf,.doc,.docx,.xls,.xlsx" />
                        <small class="text-muted">Maximum file size: 500KB (PDF, Word, Excel files only)</small>
                    </div>

                    <!-- Submit -->
                    <div class="text-end">
                        <button type="submit" class="btn btn-dark rounded-pill px-4">Submit Claim</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}

