@{
    ViewData["Title"] = "Approve Claims";
}
@* /*Troelson and Japiske, 2021*/ *@
<div class="container mt-4">
    <h1 class="display-4 fw-bold">Manager Dashboard</h1>
    <h2 class="mb-4">Approve Claims</h2>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Lecturer</th>
                <th>Month</th>
                <th>Total Hours</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Submission Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.Lecturer.FullName</td>
                    <td>@claim.Month</td>
                    <td>@claim.TotalHoursWorked</td>
                    <td>R @claim.TotalAmount</td>
                    <td>@claim.ClaimStatus</td>
                    <td>@claim.SubmissionDate.ToShortDateString()</td>
                    <td>
                        <form asp-action="Approve" asp-route-id="@claim.ClaimId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@claim.ClaimId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@* /*Reference List:
Troelsen,A. and Japikse, P. 2021.Pro C# 9 with .NET 5:Foundational Principles and Practices in Programming. 10th ed.Apress.
 */ *@