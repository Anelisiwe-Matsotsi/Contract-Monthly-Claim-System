                    <a href="/Approvals/Reject/1" class="btn btn-sm btn-danger">Reject</a>
                </td>
            </tr>
            <tr>
                <td>Andile Beke</td>
                <td>August</td>
                <td>70</td>
                <td>R7000</td>
                <td><span class="badge bg-warning text-dark">Pending</span></td>
                <td>
                    <a href="/Approvals/Approve/1" class="btn btn-sm btn-success">Approve</a>
                    <a href="/Approvals/Reject/1" class="btn btn-sm btn-danger">Reject</a>
                </td>
            </tr>
        </tbody>
    </table>
</div>